# Copy this to deploy.env (untracked) and fill it in. scripts/deploy.sh and
# scripts/teardown.sh read it. No other config file is needed.

# Named AWS CLI profile to deploy with. Unset to use your default profile.
# AWS_PROFILE=my-profile

AWS_REGION=us-east-1

# Email for the first Cognito login. deploy.sh creates this user on first deploy
# with a random temporary password, printed by the deploy and changed on the
# first sign-in.
LOGIN_EMAIL=you@example.com

# Optional. The stack name, and the prefix for every AWS resource. Defaults to
# bivack if unset.
# STACK_NAME=bivack

# Coding agent CLIs baked into the MicroVM image. Claude Code is included by
# default; comment it out (or set it empty) to exclude it. Add the other CLIs
# as needed. `latest` selects the current release; a version pins it.
CLAUDE=latest
# CODEX=latest
# OPENCODE=latest
# KIRO=latest                 # latest only; Kiro does not support version pins

# Other optional tools baked into the MicroVM image. Leave a setting commented
# out (or empty) to exclude it; `latest` selects its current release; a version
# pins it. Prefer pinned OpenTofu and Terraform versions for reproducible images.
# CDK=latest
# SAM=latest
# TOFU=1.12.6
# TERRAFORM=1.16.3

# Optional runtime knobs. Defaults are shown; uncomment to change.
# MEMORY_MIB=4096             # MicroVM memory tier: 512, 1024, 2048, 4096, or 8192
# IDLE_MAX_SECONDS=7200       # suspend after this long with no inbound traffic
# IDLE_SUSPEND_SECONDS=1800   # how long a suspended VM stays resumable
# MAX_LIFETIME_SECONDS=28800  # hard maximum VM lifetime
# BUDGET_EMAIL=you@example.com # enables monthly budget alerts at 80% and 100%
# BUDGET_USD=25                # monthly budget in USD; only used with BUDGET_EMAIL
# INITIAL_PASSWORD=           # temporary password for the first login (default: random)
# NAT_MODE=instance           # private-subnet egress: "instance" (~$3/mo) or "gateway" (~$33/mo)
